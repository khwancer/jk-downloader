{
  "manifest_version": 3,
  "name": "JK Downloader",
  "version": "2.1.0",
  "description": "Revisa automáticamente nuevos episodios en JKAnime, notifica tus favoritos y descarga directo desde MediaFire, Mp4Upload y más.",
  "permissions": [
    "alarms",
    "storage",
    "notifications"
  ],
  "host_permissions": [
    "*://jkanime.net/*",
    "*://*.jkanime.net/*",
    "*://mediafire.com/*",
    "*://*.mediafire.com/*",
    "*://mp4upload.com/*",
    "*://*.mp4upload.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://mp4upload.com/*",
        "*://*.mp4upload.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
